leolaniWorld:leolani_know_Mehmet {
    leolaniWorld:leolani n2mu:know leolaniFriends:Mehmet .
}

leolaniWorld:Claims {
    leolaniWorld:chat999999.1_experiencer_Mehmet a gaf:Assertion,

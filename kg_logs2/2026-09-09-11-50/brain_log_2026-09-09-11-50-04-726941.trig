        gaf:denotes leolaniWorld:chat999999.1_experiencer_Mehmet ;
        grasp:hasAttribution leolaniTalk:chat999999.1_experiencer_Mehmet_310-118 ;
        grasp:wasAttributedTo leolaniFriends:Mehmet ;
        sem:hasBeginTimeStamp "2026-09-09 11:50:04.250100"^^xml1:string ;

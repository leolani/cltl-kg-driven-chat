    graspf:CERTAIN a grasp:AttributionValue,
            graspf:CertaintyValue ;
        rdfs:label "CERTAIN" .

    graspf:POSITIVE a grasp:AttributionValue,
            graspf:PolarityValue ;
        rdfs:label "POSITIVE" .

    graspl:UNDERSPECIFIED a n2mu:LevelValue,
            grasp:AttributionValue ;
        rdfs:label "UNDERSPECIFIED" .

    grasps:UNDERSPECIFIED a grasp:AttributionValue,
            grasps:SentimentValue ;
        rdfs:label "UNDERSPECIFIED" .

    leolaniTalk:chat999999_utterance1_char0-15 a gaf:Mention,
            grasp:Statement ;
        rdfs:label "chat999999_utterance1_char0-15" ;
        gaf:containsDenotation leolaniFriends:Mehmet,
            n2mu:chat999999.1,

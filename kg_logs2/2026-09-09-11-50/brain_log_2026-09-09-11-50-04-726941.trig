leolaniTalk:Perspectives {
    leolaniTalk:chat999999.1_experiencer_Mehmet_310-118 a grasp:Attribution ;
        rdfs:label "chat999999.1_experiencer_Mehmet_310-118" ;
        grasp:isAttributionFor leolaniTalk:chat999999_utterance1_char0-15 ;
        rdf:value graspe:SADNESS,
            graspf:CERTAIN,
            graspf:POSITIVE,
            graspl:UNDERSPECIFIED,
            grasps:UNDERSPECIFIED .

    graspe:SADNESS a grasp:AttributionValue,
